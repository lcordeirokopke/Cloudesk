    {
      "id": 6,
      "type": "barchart",
      "title": "Casos em risco e vencidos por fila",
      "description": "at_risk: 50% a menos de 100% do SLA; breached: 100% ou mais. with_ai conta desde a última mensagem do lojista sem resposta da IA; awaiting_human, desde a entrada na fila.",
