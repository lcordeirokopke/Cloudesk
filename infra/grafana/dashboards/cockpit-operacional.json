{
  "uid": "cloudesk-cockpit",
  "title": "Cloudesk - Cockpit operacional",
  "description": "Profundidade por fila, casos em risco de SLA, contenção da IA, Pareto de motivos de escalação, lag do Kafka, backlog e fila de falhas do Solid Queue, e alertas.",
  "tags": [
    "cloudesk"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Contenção da IA (24 h)",
      "description": "Resolvidas pela IA sem handoff anterior, sobre todas as resolvidas nas últimas 24 h.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(cloudesk_conversations_resolved_by_ai_24h{brand=~\"$brand\"}) / sum(cloudesk_conversations_resolved_24h{brand=~\"$brand\"})",
          "legendFormat": "contenção",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
