<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Admin" %> · Cloudesk</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Cloudesk">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="panel admin">
    <header class="panel-header">
      <%= link_to current_brand ? admin_rules_path : admin_root_path, class: "panel-header__brand" do %>
        <span class="cw-wordmark">cloudesk</span><span class="cw-product">Admin</span>
      <% end %>
      <% if current_brand %>
        <nav class="admin-nav" aria-label="Seções do admin">
          <% { "Filas" => [ admin_queues_path, "queues" ], "Equipes" => [ admin_teams_path, "teams" ],
               "Atendentes" => [ admin_attendants_path, "attendants" ], "Regras" => [ admin_rules_path, "rules" ],
               "DLQ" => [ admin_dlq_path, "dlq" ] }.each do |label, (path, section)| %>
            <%= link_to label, path, aria: { current: ("page" if controller_name == section) } %>
          <% end %>
        </nav>
      <% end %>
      <span class="panel-header__who">
        <%= current_brand&.name %><% if current_brand && operator_name %> · <% end %><%= operator_name && "operador #{operator_name}" %>
      </span>
      <% if current_brand %>
        <%= button_to "Trocar marca", admin_session_path, method: :delete, class: "panel-button panel-button--ghost",
                                                          form_class: "panel-header__logout" %>
      <% end %>
    </header>

    <% if flash[:alert] %><p class="panel-flash panel-flash--alert"><%= flash[:alert] %></p><% end %>
    <% if flash[:notice] %><p class="panel-flash panel-flash--notice"><%= flash[:notice] %></p><% end %>

    <main class="panel-main">
      <%= yield %>
    </main>
  </body>
</html>
