{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cloudesk:contract:v1:context",
  "title": "Contexto da conversa",
  "description": "Corpo da resposta do Core ao GET da context_url: histórico da conversa e memória do lojista.",
  "type": "object",
  "required": ["conversation", "messages", "customer_memory"],
  "additionalProperties": false,
  "properties": {
    "conversation": {
      "type": "object",
      "required": ["id", "brand", "channel", "state", "last_sequence"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "brand": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "channel": { "enum": ["chat", "whatsapp", "email"] },
        "state": { "enum": ["triage", "with_ai", "awaiting_human", "with_human", "resolved", "closed"] },
        "last_sequence": { "type": "integer", "minimum": 0 }
      }
    },
    "messages": {
      "type": "array",
      "description": "Histórico completo, em ordem crescente de sequence.",
      "items": {
        "type": "object",
        "required": ["sequence", "author", "channel", "text", "created_at"],
        "additionalProperties": false,
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "author": { "enum": ["customer", "ai", "analyst", "system"] },
          "channel": { "enum": ["chat", "whatsapp", "email"] },
          "text": { "type": "string", "minLength": 1 },
          "created_at": { "$ref": "#/$defs/timestamp" }
        }
      }
    },
    "customer_memory": {
      "description": "Resumo das conversas anteriores do lojista, ou null quando não existe.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["summary", "updated_at"],
          "additionalProperties": false,
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "updated_at": { "$ref": "#/$defs/timestamp" }
          }
        }
      ]
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  }
}
