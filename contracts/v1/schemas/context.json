{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cloudesk:contract:v1:context",
  "title": "Contexto da conversa",
  "description": "Corpo da resposta do Core ao GET da context_url: histórico da conversa e memória do lojista.",
  "type": "object",
  "required": ["conversation", "messages", "customer_memory"],
  "additionalProperties": false,
  "properties": {
    "conversation": {
      "type": "object",
      "required": ["id", "brand", "channel", "state", "last_sequence"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "brand": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "channel": { "enum": ["chat", "whatsapp", "email"] },
        "state": { "enum": ["triage", "with_ai", "awaiting_human", "with_human", "resolved", "closed"] },
        "last_sequence": { "type": "integer", "minimum": 0 }
      }
    },
    "messages": {
      "type": "array",
      "description": "Histórico completo, em ordem crescente de sequence.",
      "items": {
        "type": "object",
        "required": ["sequence", "author", "channel", "text", "created_at"],
        "additionalProperties": false,
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "author": { "enum": ["customer", "ai", "analyst", "system"] },
          "channel": { "enum": ["chat", "whatsapp", "email"] },
          "text": { "type": "string", "minLength": 1 },
          "created_at": { "$ref": "#/$defs/timestamp" }
        }
      }
    },
    "customer_memory": {
      "description": "Memória do lojista: resumo em texto e uma entrada por conversa encerrada (até 5, da resolvida mais recentemente para a mais antiga), ou null quando o lojista não tem conversa encerrada.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["summary", "updated_at", "conversations"],
          "additionalProperties": false,
          "properties": {
            "summary": { "type": "string", "minLength": 1, "description": "Uma linha por conversa, no locale do lojista." },
            "updated_at": { "$ref": "#/$defs/timestamp" },
            "conversations": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "required": ["category", "channel", "resolved_by", "resolved_at", "handoff_reason", "first_message"],
                "additionalProperties": false,
                "properties": {
                  "category": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
                  "channel": { "enum": ["chat", "whatsapp", "email"], "description": "Canal da primeira mensagem da conversa." },
                  "resolved_by": { "enum": ["ai", "analyst"] },
                  "resolved_at": { "$ref": "#/$defs/timestamp" },
                  "handoff_reason": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }], "description": "Motivo do handoff mais recente da conversa, ou null sem handoff." },
                  "first_message": { "type": "string", "minLength": 1, "maxLength": 80, "description": "Início da primeira mensagem do lojista." }
                }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  }
}
