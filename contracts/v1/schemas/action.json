{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cloudesk:contract:v1:action",
  "title": "Ação do agente",
  "description": "Valor da mensagem Kafka em agent.outbound e corpo da chamada do Broker à API de ações do Core. A chave da mensagem Kafka é o conversation_id.",
  "type": "object",
  "required": ["type", "inbound_event_id", "brand", "conversation_id", "based_on_sequence", "tools", "timestamps", "traceparent"],
  "unevaluatedProperties": false,
  "properties": {
    "type": { "enum": ["reply", "escalate", "categorize", "resolve"] },
    "inbound_event_id": { "$ref": "#/$defs/uuid", "description": "event_id do evento message.created que originou a ação. Com o type, forma a Idempotency-Key." },
    "brand": { "$ref": "#/$defs/brand" },
    "conversation_id": { "$ref": "#/$defs/uuid" },
    "based_on_sequence": { "type": "integer", "minimum": 1, "description": "Sequência da última mensagem que o agente considerou." },
    "tools": {
      "type": "array",
      "description": "Registro das ferramentas consultadas, na ordem das chamadas.",
      "items": { "$ref": "#/$defs/tool_call" }
    },
    "timestamps": {
      "type": "object",
      "required": ["broker_received_at", "kafka_appended_at", "agent_consumed_at", "agent_published_at"],
      "additionalProperties": false,
      "properties": {
        "broker_received_at": { "$ref": "#/$defs/timestamp", "description": "Header broker_received_at do evento, devolvido pelo agente." },
        "kafka_appended_at": { "$ref": "#/$defs/timestamp", "description": "Timestamp do registro Kafka do evento, devolvido pelo agente." },
        "agent_consumed_at": { "$ref": "#/$defs/timestamp", "description": "Horário em que o agente consumiu o evento." },
        "agent_published_at": { "$ref": "#/$defs/timestamp", "description": "Horário em que o agente publicou a ação." }
      }
    },
    "model": {
      "type": "object",
      "description": "Presente quando a decisão vem de um LLM.",
      "required": ["name", "version", "parameters"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object" }
      }
    },
    "traceparent": { "$ref": "#/$defs/traceparent" }
  },
  "oneOf": [
    {
      "title": "reply",
      "required": ["text"],
      "properties": {
        "type": { "const": "reply" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    {
      "title": "escalate",
      "required": ["reason", "summary", "context"],
      "properties": {
        "type": { "const": "escalate" },
        "reason": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "context": {
          "type": "object",
          "required": ["intent", "entities", "tools", "attempts", "sentiment", "suggested_next_step", "confidence"],
          "additionalProperties": false,
          "properties": {
            "intent": { "type": "string", "minLength": 1 },
            "entities": { "type": "object" },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "output"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "output": { "type": "object" }
                }
              }
            },
            "attempts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "sentiment": { "enum": ["negative", "neutral", "positive"] },
            "suggested_next_step": { "type": "string", "minLength": 1 },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    {
      "title": "categorize",
      "required": ["category"],
      "properties": {
        "type": { "const": "categorize" },
        "category": { "type": "string", "minLength": 1 }
      }
    },
    {
      "title": "resolve",
      "properties": {
        "type": { "const": "resolve" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  ],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "brand": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "traceparent": { "type": "string", "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$" },
    "tool_call": {
      "type": "object",
      "required": ["name", "input", "output", "started_at", "finished_at"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "input": { "type": "object" },
        "output": { "type": "object" },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "finished_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
