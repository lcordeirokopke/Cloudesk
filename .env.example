# Copiar para .env e preencher as senhas. O .env não é versionado.

# Superusuário da imagem do Postgres; usado só pelo script de inicialização.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

# Papel dono: migrações, seeds e preparo do banco de teste.
DB_OWNER_USERNAME=cloudesk_owner
DB_OWNER_PASSWORD=

# Papel da aplicação: web, workers e testes.
DB_APP_USERNAME=cloudesk_app
DB_APP_PASSWORD=

DB_DEVELOPMENT_NAME=cloudesk_development
DB_TEST_NAME=cloudesk_test

# Canais. Cada segredo é um texto aleatório gerado para o projeto (por exemplo, openssl rand -hex 32);
# não existe conta na Meta.
# WhatsApp: assinatura X-Hub-Signature-256, token da verificação GET e Bearer token do envio.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# Base do envio do WhatsApp, com o segmento de versão: POST {url}/{phone_number_id}/messages.
# O valor é o endereço do simulador de canais.
WHATSAPP_API_URL=http://channel-simulator:8080/v1
# Chat: assinatura HMAC da entrada JSON.
CHAT_SIGNING_SECRET=
# Basic auth do webhook do Mailpit para o Core (só letras e números: o valor vai na URL).
MAILPIT_WEBHOOK_USER=mailpit
MAILPIT_WEBHOOK_PASSWORD=

# Webhook do Core ao Broker. O segredo é o mesmo no broker-web.
BROKER_WEBHOOK_URL=http://broker-web:3000/webhooks/message-created
BROKER_WEBHOOK_SECRET=

# Broker (broker-web e broker-consumer). Os valores comentados são os padrões do compose.yaml.
# KAFKA_BROKERS=redpanda:9092
# CORE_ACTIONS_URL=http://web:3000/api/v1/agent/actions

# API do agente no Core. Cada segredo é um texto aleatório gerado para o projeto.
# AGENT_ACTIONS_SECRET assina as chamadas do Broker (broker-consumer) a POST /api/v1/agent/actions;
# AGENT_CONTEXT_SECRET assina o GET da context_url feito pelo agente.
AGENT_ACTIONS_SECRET=
AGENT_CONTEXT_SECRET=

# Agente mock (agent-mock). Os valores comentados são os padrões do compose.yaml.
# AGENT_LATENCY_MS: latência artificial fixa antes de cada publicação, em milissegundos.
# AGENT_CONCURRENCY: eventos em andamento por processo, em série dentro da mesma conversa.
# AGENT_FAILURE_MODE: modo de falha (none, delay, drop, duplicate ou stale).
# AGENT_FAILURE_RATE: fração dos eventos afetados, de 0 a 1, escolhidos pelo SHA-256 do event_id.
# AGENT_FAILURE_DELAY_MS: atraso somado à latência no modo delay, em milissegundos.
# AGENT_LATENCY_MS=0
# AGENT_CONCURRENCY=100
# AGENT_FAILURE_MODE=none
# AGENT_FAILURE_RATE=1
# AGENT_FAILURE_DELAY_MS=0

# Basic auth do painel do Mission Control - Jobs, em http://localhost:3000/jobs.
MISSION_CONTROL_USER=admin
MISSION_CONTROL_PASSWORD=

# Basic auth do painel do analista, em http://localhost:3000/panel.
PANEL_USER=analyst
PANEL_PASSWORD=
