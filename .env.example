# Copiar para .env, que não é versionado. Os valores são de demonstração, só para uso local com dados
# sintéticos; fora disso, trocar todas as senhas e segredos (por exemplo, openssl rand -hex 32).
# As senhas do Postgres e do administrador do Grafana valem na criação dos volumes deles; a exceção é
# DB_MONITOR_PASSWORD, regravada a cada subida.

# Superusuário da imagem do Postgres; usado só pelo script de inicialização.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cloudesk-demo-postgres

# Papel dono: migrações, seeds e preparo do banco de teste.
DB_OWNER_USERNAME=cloudesk_owner
DB_OWNER_PASSWORD=cloudesk-demo-owner

# Papel da aplicação: web, workers e testes.
DB_APP_USERNAME=cloudesk_app
DB_APP_PASSWORD=cloudesk-demo-app

DB_DEVELOPMENT_NAME=cloudesk_development
DB_TEST_NAME=cloudesk_test

# Canais. Cada segredo é um texto livre, igual nos dois lados; não existe conta na Meta.
# WhatsApp: assinatura X-Hub-Signature-256, token da verificação GET e Bearer token do envio.
WHATSAPP_APP_SECRET=cloudesk-demo-whatsapp-app-secret
WHATSAPP_VERIFY_TOKEN=cloudesk-demo-whatsapp-verify-token
WHATSAPP_ACCESS_TOKEN=cloudesk-demo-whatsapp-access-token
# Base do envio do WhatsApp, com o segmento de versão: POST {url}/{phone_number_id}/messages.
# O valor é o endereço do simulador de canais.
WHATSAPP_API_URL=http://channel-simulator:8080/v1
# Chat: assinatura HMAC da entrada JSON.
CHAT_SIGNING_SECRET=cloudesk-demo-chat-signing-secret
# Basic auth do webhook do Mailpit para o Core (só letras e números: o valor vai na URL).
MAILPIT_WEBHOOK_USER=mailpit
MAILPIT_WEBHOOK_PASSWORD=cloudeskdemomailpit

# Webhook do Core ao Broker. O segredo é o mesmo no broker-web.
BROKER_WEBHOOK_URL=http://broker-web:3000/webhooks/message-created
BROKER_WEBHOOK_SECRET=cloudesk-demo-broker-webhook-secret

# Broker (broker-web e broker-consumer). Os valores comentados são os padrões do compose.yaml.
# KAFKA_BROKERS=redpanda:9092
# CORE_ACTIONS_URL=http://web-lb:3000/api/v1/agent/actions

# DLQ Kafka. BROKER_DLQ_SECRET é um texto livre, igual nos dois lados, que assina as chamadas do Core
# (tela /admin/dlq) aos endpoints da DLQ no broker-web. O valor comentado de
# BROKER_DLQ_URL é o padrão do compose.yaml.
BROKER_DLQ_SECRET=cloudesk-demo-broker-dlq-secret
# BROKER_DLQ_URL=http://broker-web:3000

# Dimensionamento. CLOUDESK_LOAD_PROFILE=1 desliga o recarregamento de código, carrega o código no
# boot e reduz os logs de desenvolvimento, para as medidas e a carga. WEB_MAX_THREADS é o número de
# threads do Puma de cada réplica do web (e de conexões do pool). POSTGRES_MAX_CONNECTIONS é o
# max_connections do Postgres. Os valores comentados são os padrões do compose.yaml.
# CLOUDESK_LOAD_PROFILE=
# WEB_MAX_THREADS=3
# POSTGRES_MAX_CONNECTIONS=200

# API do agente no Core. Cada segredo é um texto livre, igual nos dois lados.
# AGENT_ACTIONS_SECRET assina as chamadas do Broker (broker-consumer) a POST /api/v1/agent/actions;
# AGENT_CONTEXT_SECRET assina o GET da context_url feito pelo agente.
AGENT_ACTIONS_SECRET=cloudesk-demo-agent-actions-secret
AGENT_CONTEXT_SECRET=cloudesk-demo-agent-context-secret

# Agente mock (agent-mock). Os valores comentados são os padrões do compose.yaml.
# AGENT_LATENCY_MS: latência artificial fixa antes de cada publicação, em milissegundos.
# AGENT_CONCURRENCY: eventos em andamento por processo, em série dentro da mesma conversa.
# AGENT_FAILURE_MODE: modo de falha (none, delay, drop, duplicate ou stale).
# AGENT_FAILURE_RATE: fração dos eventos afetados, de 0 a 1, escolhidos pelo SHA-256 do event_id.
# AGENT_FAILURE_DELAY_MS: atraso somado à latência no modo delay, em milissegundos.
# AGENT_MEMORY_WINDOW_DAYS: dias antes da mensagem em que uma conversa encerrada do mesmo assunto, na
# memória do lojista, entra no início da resposta do agente e reduz a confiança da escalação.
# AGENT_INBOUND_TOPIC e AGENT_OUTBOUND_TOPIC: tópicos de entrada e de saída do agente. O compose.yaml
# não os passa ao agent-mock, que usa os padrões do agente (agent.inbound e agent.outbound); o
# agent-mock-conformance, do profile conformance, usa conformance.inbound e conformance.outbound.
# AGENT_LATENCY_MS=0
# AGENT_CONCURRENCY=100
# AGENT_FAILURE_MODE=none
# AGENT_FAILURE_RATE=1
# AGENT_FAILURE_DELAY_MS=0
# AGENT_MEMORY_WINDOW_DAYS=30
# AGENT_INBOUND_TOPIC=agent.inbound
# AGENT_OUTBOUND_TOPIC=agent.outbound

# Basic auth do painel do Mission Control - Jobs, em http://localhost:3000/jobs.
MISSION_CONTROL_USER=admin
MISSION_CONTROL_PASSWORD=cloudesk-demo-jobs

# Basic auth do painel do analista, em http://localhost:3000/panel.
PANEL_USER=analyst
PANEL_PASSWORD=cloudesk-demo-panel

# Basic auth do admin de filas e regras, em http://localhost:3000/admin.
ADMIN_USER=operator
ADMIN_PASSWORD=cloudesk-demo-admin

# Observabilidade. Papel de monitoração do Postgres (pg_monitor, sem acesso ao domínio), criado pelo
# serviço postgres-monitor-init, e credenciais do administrador do Grafana (localhost:3002).
DB_MONITOR_USERNAME=cloudesk_monitor
DB_MONITOR_PASSWORD=cloudesk-demo-monitor
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cloudesk-demo-grafana
